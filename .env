DATABASE_URL=file:/home/z/my-project/db/custom.db

# =============================================================================
# WhatsApp Business API (Meta Cloud API)
# Get these from: https://developers.facebook.com/apps/
# =============================================================================
# Permanent access token from WhatsApp > API Setup
WA_ACCESS_TOKEN=

# Phone Number ID from WhatsApp > API Setup
WA_PHONE_NUMBER_ID=

# WhatsApp Business Account ID (from Business Manager)
WA_BUSINESS_ACCOUNT_ID=

# Any random string you choose — used to verify webhook authenticity
WA_WEBHOOK_VERIFY_TOKEN=your_random_secret_string_here

# Public URL where Meta delivers webhook events (your deployed site + /api/whatsapp/webhook)
WA_WEBHOOK_URL=

# =============================================================================
# OpenAI API (Optional — enables smarter AI responses)
# Without this, the bot uses keyword-based fallback responses
# =============================================================================
OPENAI_API_KEY=
