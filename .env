DATABASE_URL=file:/home/z/my-project/db/custom.db

# =============================================================================
# WhatsApp via Twilio (EASIEST — Recommended)
# Setup: https://www.twilio.com/try-twilio
# =============================================================================
# From your Twilio Console dashboard
TWILIO_ACCOUNT_SID=

# From your Twilio Console dashboard (keep secret!)
TWILIO_AUTH_TOKEN=

# Your Twilio WhatsApp number (from WhatsApp Sandbox)
# Format: whatsapp:+14155552671
TWILIO_WHATSAPP_NUMBER=

# =============================================================================
# WhatsApp via Meta Cloud API (Advanced — only if Twilio doesn't work for you)
# Setup: https://developers.facebook.com/apps/
# =============================================================================
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_WEBHOOK_VERIFY_TOKEN=your_random_secret_string_here
WA_WEBHOOK_URL=

# =============================================================================
# OpenAI API (Optional — enables smarter AI responses)
# Without this, the bot uses keyword-based fallback responses
# =============================================================================
OPENAI_API_KEY=
